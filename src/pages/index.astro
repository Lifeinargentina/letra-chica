---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import ArticuloCard from '../components/ArticuloCard.astro';
import Footer from '../components/Footer.astro';

const all = (await getCollection('articulos', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const cover   = all.find(a => a.data.homepageSlot === 'cover') ?? all.find(a => a.data.featured) ?? all[0];
const sidebar = all.filter(a => a.id !== cover?.id && a.data.homepageSlot === 'sidebar').slice(0, 4);
const latest  = all.filter(a => a.id !== cover?.id && a.data.homepageSlot === 'latest');
const focus   = all.filter(a => a.id !== cover?.id && a.data.homepageSlot === 'focus');

const grid = latest.length ? latest : all.filter(a => a.id !== cover?.id && !sidebar.includes(a)).slice(0, 6);
---
<BaseLayout>
  <Masthead />

  <main class="container">

    <!-- Lead section: cover article (2/3) + sidebar list (1/3) -->
    {cover && (
      <section class="lead-section">
        <div class="lead-grid">
          <div class="lead-main">
            <ArticuloCard
              title={cover.data.title}
              excerpt={cover.data.excerpt}
              category={cover.data.category}
              date={cover.data.date}
              author={cover.data.author}
              slug={cover.id}
              image={cover.data.image}
              imageAlt={cover.data.imageAlt}
              variant="lead"
            />
          </div>

          {sidebar.length > 0 && (
            <aside class="lead-sidebar">
              {sidebar.map(art => (
                <ArticuloCard
                  title={art.data.title}
                  excerpt={art.data.excerpt}
                  category={art.data.category}
                  date={art.data.date}
                  author={art.data.author}
                  slug={art.id}
                  variant="sidebar"
                />
              ))}
            </aside>
          )}
        </div>
      </section>
    )}

    <!-- Secondary grid: 3 columns with filetes -->
    {grid.length > 0 && (
      <section class="secondary-section">
        <div class="section-label rubrica">Más recientes</div>
        <div class="secondary-grid">
          {grid.map(art => (
            <div class="grid-cell">
              <ArticuloCard
                title={art.data.title}
                excerpt={art.data.excerpt}
                category={art.data.category}
                date={art.data.date}
                author={art.data.author}
                slug={art.id}
                image={art.data.image}
                imageAlt={art.data.imageAlt}
                variant="grid"
              />
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Compact notes: homepageSlot === 'focus' -->
    {focus.length > 0 && (
      <section class="notes-section">
        <div class="section-label rubrica">Notas breves</div>
        <div class="notes-grid">
          {focus.map(art => (
            <div class="note-cell">
              <ArticuloCard
                title={art.data.title}
                excerpt={art.data.excerpt}
                category={art.data.category}
                date={art.data.date}
                author={art.data.author}
                slug={art.id}
                variant="compact"
              />
            </div>
          ))}
        </div>
      </section>
    )}

  </main>

  <!-- Newsletter: full-width lavender band, outside container -->
  <section class="newsletter-band" id="newsletter">
    <div class="container">
      <div class="newsletter-inner">
        <div class="newsletter-copy">
          <h2 class="newsletter-title">letra chica<sup class="nl-sup">¹</sup> en tu inbox.</h2>
          <p class="newsletter-text">
            Una selección breve de notas sobre derecho corporativo, regulación y las cosas
            que suelen aparecer en el margen.
          </p>
        </div>
        <form
          class="newsletter-form"
          action="https://formspree.io/f/YOUR_NEWSLETTER_ID"
          method="POST"
        >
          <input type="hidden" name="_subject" value="Nueva suscripción · letra chica¹" />
          <div class="nl-field">
            <input
              type="email"
              name="email"
              placeholder="tu@email.com"
              required
              aria-label="Correo electrónico"
              class="nl-input"
            />
            <button type="submit" class="nl-btn">Suscribirme</button>
          </div>
        </form>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
/* Lead section */
.lead-section {
  padding: 36px 0 0;
}

.lead-grid {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 0;
  border-top: 1px solid var(--line);
  padding-top: 28px;
}

.lead-main {
  padding-right: 40px;
  border-right: 1px solid var(--line);
}

.lead-sidebar {
  padding-left: 32px;
}

/* Secondary grid */
.secondary-section {
  padding: 52px 0 0;
}

.section-label {
  margin-bottom: 20px;
  padding-bottom: 12px;
  border-bottom: 3px solid var(--lav);
}

.secondary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
}

.grid-cell {
  padding: 0 28px;
  border-right: 1px solid var(--line);
}

.grid-cell:nth-child(3n + 1) {
  padding-left: 0;
}

.grid-cell:nth-child(3n) {
  border-right: none;
  padding-right: 0;
}

/* Compact notes */
.notes-section {
  padding: 52px 0 0;
}

.notes-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
}

.note-cell {
  padding: 0 28px;
  border-right: 1px solid var(--line);
}

.note-cell:nth-child(3n + 1) {
  padding-left: 0;
}

.note-cell:nth-child(3n) {
  border-right: none;
  padding-right: 0;
}

/* Newsletter band — full-width lavender */
.newsletter-band {
  background: var(--lav);
  margin-top: 64px;
  padding: 56px 0 60px;
}

.newsletter-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: end;
}

.newsletter-title {
  font-family: var(--font-display);
  font-size: clamp(28px, 4vw, 44px);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--black);
  margin-bottom: 12px;
}

.nl-sup {
  color: var(--red);
  font-size: 0.4em;
  vertical-align: super;
  font-style: normal;
  font-weight: 700;
}

.newsletter-text {
  font-family: var(--font-body);
  font-weight: 300;
  font-size: 14px;
  line-height: 1.65;
  color: var(--black);
  max-width: 420px;
}

.newsletter-form {
  padding-bottom: 4px;
}

.nl-field {
  display: grid;
  grid-template-columns: 1fr auto;
  border-bottom: 2px solid var(--black);
}

.nl-input {
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 300;
  color: var(--black);
  background: transparent;
  border: none;
  outline: none;
  padding: 12px 0;
}

.nl-input::placeholder {
  color: #555;
}

.nl-btn {
  font-family: var(--font-body);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--white);
  background: var(--black);
  border: none;
  padding: 0 20px;
  cursor: pointer;
}

.nl-btn:hover {
  background: #333;
}

/* Responsive */
@media (max-width: 960px) {
  .lead-grid {
    grid-template-columns: 1fr;
  }
  .lead-main {
    padding-right: 0;
    border-right: none;
    border-bottom: 1px solid var(--line);
    padding-bottom: 28px;
    margin-bottom: 24px;
  }
  .lead-sidebar {
    padding-left: 0;
  }
  .secondary-grid,
  .notes-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  /* Reset 3-col nth-child, apply 2-col */
  .grid-cell,
  .note-cell {
    padding: 0 24px;
    border-right: 1px solid var(--line);
  }
  .grid-cell:nth-child(3n + 1),
  .note-cell:nth-child(3n + 1) {
    padding-left: 24px;
  }
  .grid-cell:nth-child(3n),
  .note-cell:nth-child(3n) {
    border-right: 1px solid var(--line);
    padding-right: 24px;
  }
  .grid-cell:nth-child(2n + 1),
  .note-cell:nth-child(2n + 1) {
    padding-left: 0;
  }
  .grid-cell:nth-child(2n),
  .note-cell:nth-child(2n) {
    border-right: none;
    padding-right: 0;
  }

  .newsletter-inner {
    grid-template-columns: 1fr;
    gap: 24px;
  }
}

@media (max-width: 600px) {
  .lead-section {
    padding: 24px 0 0;
  }
  .secondary-section,
  .notes-section {
    padding: 36px 0 0;
  }
  .newsletter-band {
    margin-top: 40px;
    padding: 40px 0 48px;
  }
  .secondary-grid,
  .notes-grid {
    grid-template-columns: 1fr;
  }
  .grid-cell,
  .note-cell {
    padding: 0 0 28px;
    border-right: none;
    border-bottom: 1px solid rgba(13,13,13,0.15);
    margin-bottom: 0;
  }
  .grid-cell:last-child,
  .note-cell:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
}
</style>
