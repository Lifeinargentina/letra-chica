---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Masthead from '../../components/Masthead.astro';
import Rubrica from '../../components/Rubrica.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('articulos', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { id: post.id },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const { title, excerpt, category, author, date, image, imageAlt, imageCaption, seoTitle, seoDescription } = post.data;
const dateStr = date.toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric' });

const allPosts = await getCollection('articulos', ({ data }) => !data.draft);
const related = allPosts
  .filter(p => p.id !== post.id && p.data.category === category)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<BaseLayout
  title={seoTitle ?? `${title} · letra chica¹`}
  description={seoDescription ?? excerpt}
>
  <Masthead />

  <main class="container">
    <article class="article-wrap">

      <header class="article-header">
        <Rubrica category={category} href={`/categoria/${category.toLowerCase()}/`} />
        <h1 class="article-title">{title}</h1>
        <p class="article-deck">{excerpt}</p>
        <div class="article-byline rubrica">
          <span>{author}</span>
          <span>{dateStr}</span>
        </div>
      </header>

      {image && (
        <figure class="article-figure">
          <img src={image} alt={imageAlt ?? title} class="article-img" />
          {imageCaption && <figcaption class="article-caption">{imageCaption}</figcaption>}
        </figure>
      )}

      <div class="prose article-body">
        <Content />
      </div>

    </article>

    {related.length > 0 && (
      <section class="related-section">
        <div class="related-label rubrica">Más artículos</div>
        <div class="related-grid">
          {related.map(art => (
            <div class="related-cell">
              <Rubrica category={art.data.category} href={`/categoria/${art.data.category.toLowerCase()}/`} />
              <h3 class="related-title">
                <a href={`/articulos/${art.id}/`}>{art.data.title}</a>
              </h3>
              <p class="related-excerpt">{art.data.excerpt}</p>
            </div>
          ))}
        </div>
      </section>
    )}
  </main>

  <Footer />
</BaseLayout>

<style>
.article-wrap {
  max-width: 640px;
  margin-inline: auto;
  padding: 48px 0 0;
}

.article-header {
  margin-bottom: 32px;
}

.article-title {
  font-family: var(--font-display);
  font-size: clamp(28px, 4vw, 46px);
  font-weight: 700;
  line-height: 1.12;
  margin: 12px 0 16px;
  color: var(--black);
}

.article-deck {
  font-family: var(--font-body);
  font-weight: 300;
  font-size: 16px;
  line-height: 1.6;
  color: var(--grey);
  margin-bottom: 20px;
}

.article-byline {
  display: flex;
  gap: 20px;
  color: var(--muted);
  padding-top: 16px;
  border-top: 1px solid var(--line);
}

.article-figure {
  max-width: 640px;
  margin: 0 auto 32px;
}

.article-img {
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
}

.article-caption {
  font-family: var(--font-body);
  font-size: 11px;
  color: var(--muted);
  margin-top: 7px;
  line-height: 1.5;
}

.article-body {
  max-width: 640px;
  margin-inline: auto;
}

/* Related */
.related-section {
  max-width: 640px;
  margin: 64px auto 0;
  border-top: 1px solid var(--line);
  padding-top: 36px;
}

.related-label {
  margin-bottom: 24px;
}

.related-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
}

.related-cell {
  padding: 0 24px;
  border-right: 1px solid var(--line);
}

.related-cell:first-child {
  padding-left: 0;
}

.related-cell:last-child {
  border-right: none;
  padding-right: 0;
}

.related-title {
  font-family: var(--font-display);
  font-size: 15px;
  font-weight: 700;
  line-height: 1.3;
  margin: 6px 0 7px;
  color: var(--black);
}

.related-title a {
  color: inherit;
  text-decoration: none;
}

.related-title a:hover {
  text-decoration: underline;
  text-underline-offset: 2px;
}

.related-excerpt {
  font-family: var(--font-body);
  font-weight: 300;
  font-size: 12px;
  line-height: 1.5;
  color: var(--grey);
}

@media (max-width: 700px) {
  .article-wrap {
    padding-top: 32px;
  }
  .article-title {
    font-size: clamp(26px, 7vw, 40px);
  }
  .article-byline {
    flex-direction: column;
    gap: 3px;
  }
  .related-section {
    margin-top: 48px;
    padding-top: 28px;
  }
  .related-grid {
    grid-template-columns: 1fr;
  }
  .related-cell {
    padding: 0;
    border-right: none;
    border-bottom: 1px solid var(--line);
    padding-bottom: 20px;
    margin-bottom: 20px;
  }
  .related-cell:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }
}
</style>
