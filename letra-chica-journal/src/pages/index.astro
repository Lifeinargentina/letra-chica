---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const articles = (await getCollection('articulos')).filter(a => !a.data.draft).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const cover = articles.find(a => a.data.homepageSlot === 'cover' || a.data.featured) ?? articles[0];
const sidebar = articles.filter(a => a.id !== cover?.id).filter(a => a.data.homepageSlot === 'sidebar').slice(0,2);
const latest = articles.filter(a => a.id !== cover?.id).slice(0,5);
const focus = articles.filter(a => a.id !== cover?.id).filter(a => a.data.homepageSlot === 'focus').slice(0,4);
const displayFocus = focus.length ? focus : articles.filter(a => a.id !== cover?.id).slice(5,9);
const fmt = (d) => new Intl.DateTimeFormat('es-AR',{day:'2-digit',month:'2-digit',year:'2-digit'}).format(d);
---
<BaseLayout>
<Header />
<section class="hero"><div class="page"><div class="hero-meta">Portada &nbsp;/&nbsp; Buenos Aires &nbsp;/&nbsp; Letra Chica₁</div><h1 class="hero-title">El problema no suele estar en lo que dice la ley.</h1><p class="hero-deck">Está en lo que ocurre alrededor: quién decide, quién controla, qué incentivos existen y qué termina pasando cuando la norma baja al mundo real.</p></div></section>

{cover && <section class="section"><div class="page"><div class="section-head"><h2>En portada</h2><span>Selección editorial</span></div><div class="lead-grid"><article class="lead-main"><a class="image-block" href={`/articulos/${cover.id}/`}>{cover.data.image ? <img src={cover.data.image} alt={cover.data.imageAlt ?? cover.data.title}/> : <div class="placeholder-art"></div>}</a><div class="lead-copy"><div class="story-label">{cover.data.category}</div><h2><a href={`/articulos/${cover.id}/`}>{cover.data.title}</a></h2><p>{cover.data.excerpt}</p><a class="read-row" href={`/articulos/${cover.id}/`}><span>Leer nota</span><span>↗</span></a></div></article><aside class="sidebar">{sidebar.map(item => <article class="sidebar-block"><div class="sidebar-tag">{item.data.category}</div><h3><a href={`/articulos/${item.id}/`}>{item.data.title}</a></h3><p>{item.data.excerpt}</p></article>)}<article class="opinion"><div class="sidebar-tag">Opinión</div><div class="opinion-badge">LC₁</div><h3>La regulación nunca llega sola.</h3><p>También llegan incentivos, interpretaciones, burocracia y consecuencias.</p></article></aside></div></div></section>}

<section class="section"><div class="page"><div class="section-head"><h2>Últimas</h2><span>Derecho, empresas y otras cuestiones</span></div><div class="latest-layout"><div class="latest-list">{latest.map((item,i)=><a href={`/articulos/${item.id}/`} class="latest-row"><div class="latest-number">{String(i+1).padStart(2,'0')}</div><div class="latest-category">{item.data.category}</div><div class="latest-title">{item.data.title}</div><div class="latest-arrow">↗</div></a>)}</div><div class="latest-feature"><div class="tag">Archivo</div><h3>Las notas quedan. El ruido pasa.</h3><p>Explorá todas las publicaciones de Letra Chica₁ ordenadas por fecha y tema.</p><a href="/archivo/"><span>Ver archivo</span><span>↗</span></a></div></div></div></section>

{displayFocus.length > 0 && <section class="section"><div class="page"><div class="section-head"><h2>En foco</h2><span>Cuatro temas</span></div><div class="topic-grid">{displayFocus.map((item,i)=><article class="topic-card"><a href={`/articulos/${item.id}/`}><div class={`topic-image ${['red','lavender','grey','paper'][i%4]}`}>{item.data.image && <img src={item.data.image} alt={item.data.imageAlt ?? item.data.title}/>}</div><div class="topic-cat">{item.data.category}</div><h3>{item.data.title}</h3><p>{item.data.excerpt}</p></a></article>)}</div></div></section>}

<section class="manifesto"><div class="page"><div class="manifesto-label">Sobre Letra Chica</div><blockquote>Lo importante suele estar acá.<sup>1</sup></blockquote></div></section>

<section class="newsletter" id="newsletter"><div class="page"><div class="newsletter-grid"><div><h2>Letra Chica<sub>1</sub> en tu inbox.</h2><p>Una selección breve de notas sobre derecho, negocios, regulación y las cosas que suelen aparecer en el margen.</p></div><form class="signup" action="#" method="post"><input type="email" name="email" placeholder="tu@email.com" aria-label="Correo electrónico"/><button type="submit">Suscribirme</button></form></div></div></section>
<Footer />
</BaseLayout>

<style>
.hero{padding:28px 0 48px;border-bottom:1px solid var(--line)}.hero-meta{text-align:center;font-size:8px;letter-spacing:.09em;text-transform:uppercase;margin-bottom:26px}.hero-title{max-width:1040px;margin:0 auto;font-family:'Libre Caslon Display',Georgia,serif;font-size:clamp(48px,6.6vw,100px);font-weight:400;line-height:.96;letter-spacing:-.04em;text-align:center}.hero-deck{max-width:650px;margin:27px auto 0;font-family:Georgia,serif;font-size:17px;line-height:1.5;text-align:center}.lead-grid{display:grid;grid-template-columns:1.65fr .8fr;gap:28px}.lead-main{display:grid;grid-template-columns:1.25fr 1fr;gap:22px;padding-right:28px;border-right:1px solid var(--line)}.image-block{background:#d8d5ce;min-height:480px;overflow:hidden}.image-block img,.topic-image img{height:100%;object-fit:cover}.placeholder-art{width:100%;height:100%;min-height:480px;background:linear-gradient(135deg,#b9b7b0 0%,#e2ded4 48%,#bcb8af 48%,#ece7de 100%)}.lead-copy h2{font-family:'Libre Caslon Display',Georgia,serif;font-size:clamp(34px,3.4vw,56px);line-height:1;font-weight:400;margin:8px 0 18px}.lead-copy p{font-family:Georgia,serif;font-size:15px;line-height:1.55}.sidebar{display:flex;flex-direction:column;gap:26px}.sidebar-block{border-top:2px solid var(--line);padding-top:8px}.sidebar-block h3{font-family:'Libre Caslon Display',Georgia,serif;font-size:25px;line-height:1.05;font-weight:400;margin:8px 0}.sidebar-block p{font-family:Georgia,serif;font-size:12px;line-height:1.45}.sidebar-tag{font-size:8px;text-transform:uppercase;letter-spacing:.08em}.opinion{background:var(--lav);padding:18px;border-top:2px solid var(--line)}.opinion-badge{width:90px;height:90px;border-radius:50%;background:var(--paper);margin:18px 0;display:flex;align-items:center;justify-content:center;font-family:'Libre Caslon Display',Georgia,serif;font-size:30px}.opinion h3{font-family:'Libre Caslon Display',Georgia,serif;font-size:24px;font-weight:400;line-height:1.05}.opinion p{margin-top:12px;font-family:Georgia,serif}.latest-layout{display:grid;grid-template-columns:1.35fr .65fr;gap:34px}.latest-list{border-top:1px solid var(--line)}.latest-row{display:grid;grid-template-columns:70px 130px 1fr 28px;gap:16px;align-items:start;padding:15px 0;border-bottom:1px solid var(--line)}.latest-number{font-family:'Libre Caslon Display',Georgia,serif;color:var(--red);font-size:25px}.latest-category{font-size:8px;text-transform:uppercase;letter-spacing:.08em;padding-top:6px}.latest-title{font-family:'Libre Caslon Display',Georgia,serif;font-size:24px;line-height:1.06}.latest-arrow{text-align:right;font-size:17px}.latest-feature{background:var(--black);color:#fff;padding:23px;min-height:100%;display:flex;flex-direction:column}.latest-feature .tag{color:var(--red);font-size:8px;text-transform:uppercase;letter-spacing:.1em}.latest-feature h3{font-family:'Libre Caslon Display',Georgia,serif;font-size:35px;font-weight:400;line-height:1;margin-top:80px}.latest-feature p{margin-top:18px;font-family:Georgia,serif;font-size:13px;line-height:1.5}.latest-feature a{margin-top:auto;border-top:1px solid #777;padding-top:10px;font-size:9px;text-transform:uppercase;display:flex;justify-content:space-between}.topic-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.topic-card{padding-right:14px;border-right:1px solid var(--line)}.topic-card:last-child{border-right:none;padding-right:0}.topic-image{height:240px;margin-bottom:12px;overflow:hidden}.topic-image.red{background:var(--red)}.topic-image.lavender{background:var(--lav)}.topic-image.grey{background:#c8c3ba}.topic-image.paper{background:linear-gradient(45deg,#ebe6dd,#d8d3ca)}.topic-cat{font-size:8px;text-transform:uppercase;letter-spacing:.08em;margin-bottom:7px}.topic-card h3{font-family:'Libre Caslon Display',Georgia,serif;font-size:24px;line-height:1.05;font-weight:400}.topic-card p{margin-top:8px;font-family:Georgia,serif;font-size:11px;line-height:1.45}.manifesto{background:var(--red);color:#fff;padding:75px 0 78px;border-bottom:1px solid var(--line)}.manifesto-label{font-size:8px;text-transform:uppercase;letter-spacing:.11em;margin-bottom:50px}.manifesto blockquote{max-width:1150px;font-family:'Libre Caslon Display',Georgia,serif;font-size:clamp(46px,6vw,89px);line-height:.96;letter-spacing:-.04em}.manifesto sup{font-family:'DM Sans',sans-serif;font-size:.22em;vertical-align:top;margin-left:4px}.newsletter{background:var(--lav);padding:48px 0;border-bottom:1px solid var(--line)}.newsletter-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:80px;align-items:end}.newsletter h2{font-family:'Libre Caslon Display',Georgia,serif;font-size:clamp(42px,5vw,72px);line-height:.95;font-weight:400}.newsletter h2 sub{font-family:'DM Sans',sans-serif;font-size:.2em;vertical-align:baseline;position:relative;bottom:-.25em;color:var(--red)}.newsletter p{margin-top:20px;max-width:560px;font-family:Georgia,serif;font-size:15px}.signup{display:grid;grid-template-columns:1fr auto;border-bottom:2px solid var(--line)}.signup input{background:transparent;border:0;outline:0;padding:14px 2px}.signup button{border:0;background:var(--black);color:#fff;padding:0 20px;cursor:pointer;text-transform:uppercase;font-size:9px}.signup button:hover{background:var(--red)}
@media(max-width:1000px){.lead-grid,.latest-layout,.newsletter-grid{grid-template-columns:1fr}.lead-main{border-right:0;padding-right:0}.topic-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:700px){.hero-title{font-size:46px}.lead-main{grid-template-columns:1fr}.image-block,.placeholder-art{min-height:340px}.latest-row{grid-template-columns:38px 1fr 25px}.latest-category{grid-column:2;grid-row:1}.latest-title{grid-column:2;grid-row:2}.latest-number{grid-row:1/3}.latest-arrow{grid-row:1/3;grid-column:3}.topic-grid{grid-template-columns:1fr}.topic-card{border-right:0;border-bottom:1px solid var(--line);padding:0 0 24px}}
</style>
