---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const posts=(await getCollection('articulos')).filter(p=>!p.data.draft);
const cats=[...new Set(posts.map(p=>p.data.category.toLowerCase()))];
export function getStaticPaths(){return ['actualidad','empresas','sociedades','fintech','justicia','personas','opinion'].map(categoria=>({params:{categoria}}));}
const { categoria }=Astro.params;
const filtered=posts.filter(p=>p.data.category.toLowerCase()===categoria).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const label=(categoria??'').charAt(0).toUpperCase()+(categoria??'').slice(1);
---
<BaseLayout title={`${label} | Letra Chica₁`}><Header/><main class="page cat-page"><div class="cat-head"><div class="kicker">Sección</div><h1>{label}</h1></div>{filtered.length ? <div class="grid">{filtered.map(p=><article>{p.data.image && <a href={`/articulos/${p.id}/`}><img src={p.data.image} alt={p.data.imageAlt ?? p.data.title}/></a>}<div class="story-label">{p.data.category}</div><h2><a href={`/articulos/${p.id}/`}>{p.data.title}</a></h2><p>{p.data.excerpt}</p></article>)}</div> : <p class="empty">Todavía no hay artículos publicados en esta sección.</p>}</main><Footer/></BaseLayout>
<style>.cat-page{padding:45px 0 80px}.cat-head{padding-bottom:40px;border-bottom:2px solid var(--line);margin-bottom:25px}.cat-head h1{font-family:'Libre Caslon Display',Georgia,serif;font-size:clamp(55px,8vw,110px);font-weight:400;line-height:.9;margin-top:12px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.grid article{padding-right:20px;border-right:1px solid var(--line)}.grid article:nth-child(3n){border-right:0}.grid img{height:260px;object-fit:cover;margin-bottom:12px}.grid h2{font-family:'Libre Caslon Display',Georgia,serif;font-size:30px;line-height:1.04;font-weight:400;margin:8px 0}.grid p,.empty{font-family:Georgia,serif;font-size:13px;line-height:1.5}@media(max-width:850px){.grid{grid-template-columns:1fr}.grid article{border-right:0;border-bottom:1px solid var(--line);padding:0 0 24px}}</style>
