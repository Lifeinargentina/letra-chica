---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
export async function getStaticPaths(){const posts=(await getCollection('articulos')).filter(p=>!p.data.draft);return posts.map(post=>({params:{id:post.id},props:{post}}));}
const { post } = Astro.props;
const { Content } = await render(post);
const all = (await getCollection('articulos')).filter(p=>!p.data.draft && p.id!==post.id).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const related = all.filter(p=>p.data.category===post.data.category).slice(0,3);
const title = post.data.seoTitle ?? `${post.data.title} | Letra Chica₁`;
const description = post.data.seoDescription ?? post.data.excerpt;
const date = new Intl.DateTimeFormat('es-AR',{day:'numeric',month:'long',year:'numeric'}).format(post.data.date);
---
<BaseLayout title={title} description={description}>
<Header />
<main class="article-page"><div class="page article-header"><div class="article-meta"><span>{post.data.category}</span><span>{date}</span></div><h1>{post.data.title}</h1><p class="deck">{post.data.excerpt}</p><div class="byline">Por {post.data.author}</div></div>{post.data.image && <figure class="hero-image"><div class="page"><img src={post.data.image} alt={post.data.imageAlt ?? post.data.title}/>{post.data.imageCaption && <figcaption>{post.data.imageCaption}</figcaption>}</div></figure>}<div class="page article-layout"><article class="article-body"><Content /></article><aside class="article-sidebar"><div class="side-title">Letra Chica₁</div><p>Derecho, negocios, regulación y poder. Una publicación independiente desde Buenos Aires.</p><a href="/#newsletter">Suscribite →</a></aside></div>{related.length>0 && <section class="related"><div class="page"><div class="section-head"><h2>Relacionado</h2><span>{post.data.category}</span></div><div class="related-grid">{related.map(item=><article><div class="story-label">{item.data.category}</div><h3><a href={`/articulos/${item.id}/`}>{item.data.title}</a></h3><p>{item.data.excerpt}</p></article>)}</div></div></section>}</main>
<Footer />
</BaseLayout>
<style>
.article-header{padding:34px 0 55px;text-align:center;border-bottom:1px solid var(--line)}.article-meta{display:flex;justify-content:center;gap:20px;font-size:8px;text-transform:uppercase;letter-spacing:.09em;margin-bottom:26px}.article-header h1{max-width:1050px;margin:auto;font-family:'Libre Caslon Display',Georgia,serif;font-size:clamp(48px,6.5vw,96px);font-weight:400;line-height:.96;letter-spacing:-.04em}.deck{max-width:700px;margin:24px auto 0;font-family:Georgia,serif;font-size:18px;line-height:1.5}.byline{margin-top:20px;font-size:8px;text-transform:uppercase;letter-spacing:.08em}.hero-image{padding:28px 0 0}.hero-image img{max-height:760px;object-fit:cover}.hero-image figcaption{font-family:Georgia,serif;font-size:10px;margin-top:8px}.article-layout{display:grid;grid-template-columns:minmax(0,760px) 260px;gap:90px;justify-content:center;padding:55px 0 80px}.article-body{font-family:Georgia,serif;font-size:17px;line-height:1.75}.article-body :global(p){margin:0 0 1.35em}.article-body :global(h2){font-family:'Libre Caslon Display',Georgia,serif;font-size:38px;line-height:1.05;font-weight:400;margin:1.5em 0 .45em}.article-body :global(h3){font-family:'Libre Caslon Display',Georgia,serif;font-size:28px;font-weight:400;margin:1.4em 0 .4em}.article-body :global(blockquote){border-left:3px solid var(--red);padding-left:22px;margin:2em 0;font-size:23px;line-height:1.45}.article-body :global(a){text-decoration:underline;text-decoration-thickness:1px}.article-sidebar{border-top:2px solid var(--line);padding-top:10px;height:max-content;position:sticky;top:20px}.side-title{font-family:'Libre Caslon Display',Georgia,serif;font-size:25px}.article-sidebar p{font-family:Georgia,serif;font-size:12px;margin:12px 0 20px}.article-sidebar a{font-size:9px;text-transform:uppercase}.related{padding:24px 0 70px;border-top:1px solid var(--line)}.related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.related-grid article{padding-right:18px;border-right:1px solid var(--line)}.related-grid article:last-child{border:0}.related-grid h3{font-family:'Libre Caslon Display',Georgia,serif;font-size:28px;line-height:1.05;font-weight:400;margin:8px 0}.related-grid p{font-family:Georgia,serif;font-size:12px}
@media(max-width:850px){.article-layout{grid-template-columns:1fr;gap:30px}.article-sidebar{position:static}.related-grid{grid-template-columns:1fr}.related-grid article{border-right:0;border-bottom:1px solid var(--line);padding-bottom:20px}}
</style>
