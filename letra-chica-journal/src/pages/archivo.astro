---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const posts=(await getCollection('articulos')).filter(p=>!p.data.draft).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const fmt=(d)=>new Intl.DateTimeFormat('es-AR',{day:'2-digit',month:'2-digit',year:'numeric'}).format(d);
---
<BaseLayout title="Archivo | Letra Chica₁"><Header/><main class="page archive"><div class="archive-head"><div class="kicker">Archivo</div><h1>Todas las notas.</h1></div><div class="archive-list">{posts.map((p,i)=><a class="row" href={`/articulos/${p.id}/`}><div>{String(i+1).padStart(2,'0')}</div><div class="cat">{p.data.category}</div><h2>{p.data.title}</h2><div>{fmt(p.data.date)}</div></a>)}</div></main><Footer/></BaseLayout>
<style>.archive{padding:45px 0 80px}.archive-head{padding-bottom:40px}.archive-head h1{font-family:'Libre Caslon Display',Georgia,serif;font-size:clamp(55px,8vw,110px);font-weight:400;line-height:.9;margin-top:12px}.archive-list{border-top:2px solid var(--line)}.row{display:grid;grid-template-columns:60px 130px 1fr 100px;gap:18px;align-items:start;padding:17px 0;border-bottom:1px solid var(--line)}.row>div{font-size:9px;text-transform:uppercase}.row h2{font-family:'Libre Caslon Display',Georgia,serif;font-size:26px;line-height:1.05;font-weight:400}@media(max-width:700px){.row{grid-template-columns:40px 1fr 80px}.cat{grid-column:2}.row h2{grid-column:2;grid-row:2}.row>div:last-child{grid-column:3;grid-row:1/3}}</style>
